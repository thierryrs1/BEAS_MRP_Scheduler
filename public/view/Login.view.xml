<mvc:View
    controllerName="mrp.app.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Page showHeader="false" class="premiumLoginBackground">
        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
            <!-- alignItems="Stretch" garante que o VBox estique seus componentes internos -->
            <VBox class="loginCardModel" alignItems="Stretch">
                
                <HBox width="100%" justifyContent="Center" class="sapUiMediumMarginBottom">
                    <Image src="assets/img/logo.png" width="160px" />
                </HBox>
                
                <Text text="Portal MRP BEAS" class="textCenter modelTitle" />
                <Text text="{/dbName}" class="textCenter modelSubtitle" />
                
                <Input id="userInput" placeholder="Usuário" width="100%" class="modelInput sapUiTinyMarginBottom" />
                <Input id="passwordInput" type="Password" placeholder="Senha" width="100%" class="modelInput" />
                
                <Text text="Entre com usuário e senha" class="textCenter modelHint" />
                
                <HBox width="100%" justifyContent="Center">
                    <Button text="Login" type="Reject" width="90%" press="onLoginPress" class="modelButton" />
                </HBox>

            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
