<mvc:View
    controllerName="mrp.app.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    
    <Page showHeader="false" class="premiumLoginBackground">
        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
            <!-- Note o alignItems="Stretch" para que os inputs e botões ocupem 100% do card -->
            <VBox class="premiumLoginCard" alignItems="Stretch">
                
                <HBox justifyContent="Center" class="sapUiMediumMarginBottom">
                    <Image src="assets/img/logo.png" width="180px" />
                </HBox>
                
                <Text text="Portal MRP BEAS" textAlign="Center" class="sapUiSmallMarginBottom premiumTitle" />
                
                <HBox justifyContent="Center" class="sapUiLargeMarginBottom">
                    <Text text="{/dbName}" class="premiumSubtitle" />
                </HBox>
                
                <Input id="userInput" placeholder="Usuário" width="100%" class="sapUiSmallMarginBottom premiumInput" />
                <Input id="passwordInput" type="Password" placeholder="Senha" width="100%" class="sapUiMediumMarginBottom premiumInput" />
                
                <Text text="Insira suas credenciais de acesso do SAP" textAlign="Center" class="sapUiMediumMarginBottom premiumHint" />
                
                <Button text="ENTRAR" type="Reject" width="100%" press="onLoginPress" class="premiumButton" />
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
