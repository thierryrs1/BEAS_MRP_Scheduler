<mvc:View
    controllerName="mrp.app.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Page showHeader="false" class="premiumLoginBackground">
        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
            <!-- Caixa Principal Modernizada -->
            <VBox class="loginCardModern" alignItems="Stretch">
                
                <HBox width="100%" justifyContent="Center" class="sapUiSmallMarginBottom">
                    <Image src="assets/img/logo.png" width="140px" />
                </HBox>
                
                <Text text="Portal MRP BEAS" class="textCenter modernTitle" />
                <Text text="{/dbName}" class="textCenter modernSubtitle sapUiLargeMarginBottom" />
                
                <!-- Usuário: Label + Input + Ícone via CSS -->
                <VBox width="100%" class="sapUiSmallMarginBottom">
                    <Label text="Usuário" class="modernLabel" />
                    <Input id="userInput" placeholder="Digite seu usuário" width="100%" class="modernInput userIcon" />
                </VBox>

                <!-- Senha: Label + Input + Ícone via CSS -->
                <VBox width="100%" class="sapUiLargeMarginBottom">
                    <Label text="Senha" class="modernLabel" />
                    <Input id="passwordInput" type="Password" placeholder="Digite sua senha" width="100%" class="modernInput passIcon" />
                </VBox>
                
                <!-- Botão Ciano Estendido -->
                <Button text="Entrar" width="100%" press="onLoginPress" class="modernButton sapUiMediumMarginBottom" />
                
                <!-- Hint Final -->
                <Text text="Use seu login e senha do SAP" class="textCenter modernHint" />
                
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
